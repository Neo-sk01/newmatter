# Required for AI email generation
OPENAI_API_KEY=sk-...

# Optional: override GPT model for research summaries (defaults to gpt-4o)
AI_RESEARCH_MODEL=

# Langfuse Configuration
# Langfuse provides observability and prompt management for AI applications
# Sign up at https://cloud.langfuse.com to obtain your credentials
# Navigate to Settings > API Keys to find your keys
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
# Use https://cloud.langfuse.com for Langfuse Cloud, or your self-hosted URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Environment label for organizing traces (development, staging, production)
LANGFUSE_TRACING_ENVIRONMENT=development

# Supabase configuration (optional for local prototyping)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ACCESS_TOKEN=
